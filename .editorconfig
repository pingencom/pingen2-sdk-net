root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# C# formatting is owned by CSharpier; only the couple of style rules the analyzers enforce live here.
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning