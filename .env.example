# Copy this file to `.env` and fill in your Pingen STAGING credentials.
# The integration tests (tests/Pingen.Tests.Integration) read these values, or the
# same real environment variables (which take precedence, so CI can inject secrets).
# See: https://api.pingen.com/documentation#section/Authentication
#
# `.env` is git-ignored - never commit real credentials.

# OAuth client credentials (client_credentials grant) for the STAGING environment.
PINGEN2_CLIENT_ID=your-staging-client-id
PINGEN2_CLIENT_SECRET=your-staging-client-secret

# Organisation to run the tests against. Optional: when your credentials have access
# to several organisations, set this to pick one. When empty, the first organisation
# returned by the API is used.
PINGEN2_ORGANIZATION_ID=

# Name of the organisation above. Optional: when set, the organisation test asserts
# the fetched organisation's name matches this value.
PINGEN2_ORGANIZATION_NAME=

# NOTE: the integration tests ALWAYS run against the Pingen STAGING environment - never
# production. This is hard-coded in the test harness and cannot be switched to prod.
