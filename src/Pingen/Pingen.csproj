<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pingen</RootNamespace>
    <Title>Pingen</Title>
    <Description>Client service for the Pingen API (letters, batches, emails, ebills, webhooks and more).</Description>
    <PackageTags>pingen;letters;postal;mail;print;ebill;email;webhooks;api;sdk;rest;json-api</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pingen.Abstractions\Pingen.Abstractions.csproj" />
  </ItemGroup>

  <!-- The internal OAuth models (AccessToken) are exercised by the unit tests. -->
  <!-- Pingen.AspNetCore wires the internal PingenAccessTokenProvider singleton into the DI container. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pingen.Tests" />
    <InternalsVisibleTo Include="Pingen.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>
</Project>
